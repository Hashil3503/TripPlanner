# /etc/tripplanner.env 로 복사해서 값을 채운다 (sudo chmod 600 /etc/tripplanner.env)
# 서비스 주소: 브라우저 주소창에 칠 주소 그대로 (끝에 / 없이)
TP_PUBLIC_URL=https://trip.example.com
# Caddy가 같은 서버에서 요청을 넘겨주므로 접속자 IP는 Caddy가 알려준 값을 쓴다
TP_TRUST_PROXY=1
# 카카오 개발자 콘솔 > 앱 > 플랫폼 키
TP_KAKAO_JS_KEY=
TP_KAKAO_REST_KEY=
# (선택) 포트·DB 위치
# TP_PORT=8000
# TP_DB_PATH=/opt/tripplanner/data/tripplanner.db
